# Frontend values are included in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Preferred for production. This is safe in the browser when RLS is enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Temporary staged-migration fallback for legacy projects.
VITE_SUPABASE_ANON_KEY=your-legacy-supabase-anon-key
VITE_APP_VERSION=local

# Optional public WhatsApp Business support link. The button remains absent
# unless the flag is true and the number is valid international digits.
VITE_WHATSAPP_SUPPORT_ENABLED=false
VITE_WHATSAPP_SUPPORT_NUMBER=2348000000000

# Google remains optional. Turnstile is required before public signup/recovery.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Edge Function secrets. Never use these values in VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
# Hosted Edge Functions receive SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS automatically.
SUPABASE_ANON_KEY=your-legacy-supabase-anon-key
# Operator scripts require SUPABASE_SECRET_KEY supplied through an untracked private environment.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional transactional email provider. Leave unset to skip payment receipt,
# access-issue, refund, and dispute emails without affecting payment state.
RESEND_API_KEY=your-resend-api-key
TRANSACTIONAL_EMAIL_FROM="PromotionSure <support@promotionsure.com.ng>"
TRANSACTIONAL_EMAIL_REPLY_TO=promotionsureapp@gmail.com
# Shared only with the scheduled dispatcher invocation.
EMAIL_DISPATCH_SECRET=generate-a-long-random-secret
# Dedicated HMAC secret for signed engagement-unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=generate-a-different-long-random-secret
# Optional public override; defaults to the project's email-unsubscribe function URL.
EMAIL_UNSUBSCRIBE_URL=
# Resend/Svix webhook signing secret from the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret
# Optional bounded worker/provider controls.
EMAIL_DISPATCH_BATCH_SIZE=20
EMAIL_PROVIDER_TIMEOUT_MS=8000
# Configure custom SMTP and the Turnstile secret in Supabase Auth settings,
# not as frontend variables or Edge Function secrets.

# Public URL used to build the payment callback URL.
APP_URL=https://your-app-domain.example

# Optional Paystack public key for browser-side features.
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
